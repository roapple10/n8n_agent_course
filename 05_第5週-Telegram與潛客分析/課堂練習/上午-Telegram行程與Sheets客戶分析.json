            "id": "f99d0f41-1bf7-4c37-8e8b-f8d65f44ae12",
            "name": "Telegram 輸入",
            "webhookId": "27b0fd8d-24fb-4f65-b02b-8a720b12162f",
            "type": "n8n-nodes-base.telegramTrigger",
            "typeVersion": 1.5,
