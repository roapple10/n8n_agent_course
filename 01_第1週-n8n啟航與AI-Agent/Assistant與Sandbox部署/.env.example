# 複製為 .env 後，以密碼管理工具或 `openssl rand -hex 32` 產生不同的值。
# .env 已被 Git 忽略，禁止提交。
SANDBOX_API_KEYS=replace-with-a-unique-long-random-value
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-with-a-different-long-random-value
SANDBOX_API_RUNNER_API_KEY=replace-with-a-third-long-random-value
SEARXNG_SECRET=replace-with-a-fourth-long-random-value
