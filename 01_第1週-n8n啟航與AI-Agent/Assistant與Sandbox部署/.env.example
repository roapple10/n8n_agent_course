# 複製為 .env 後，以密碼管理工具或 `openssl rand -hex 32` 產生不同的值。
# .env 已被 Git 忽略，禁止提交。
SANDBOX_API_KEYS=replace-with-a-unique-long-random-value
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-with-a-different-long-random-value
SANDBOX_API_RUNNER_API_KEY=replace-with-a-third-long-random-value
SEARXNG_SECRET=replace-with-a-fourth-long-random-value
N8N_TEST_OWNER_EMAIL=n8n-course-test@local.test
N8N_TEST_OWNER_FIRST_NAME=Course
N8N_TEST_OWNER_LAST_NAME=Tester
N8N_TEST_OWNER_PASSWORD=CourseTest_2026!n8n

# Cloudflare Quick Tunnel：先執行 cloudflared tunnel --url http://localhost:5678
# 將終端機產生的 https://....trycloudflare.com 網址貼在下方，並保留最後的斜線。
# 每次重新建立 Quick Tunnel 若網址改變，也要更新這一行並重啟 n8n。
N8N_WEBHOOK_URL=https://replace-with-your-quick-tunnel.trycloudflare.com/

# n8n 位於 Cloudflare Tunnel 後方時，保留 1。
N8N_PROXY_HOPS=1
